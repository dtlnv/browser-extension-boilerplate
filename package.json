{
  "name": "browser-extension-boilerplate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:chromium": "bun scripts/build.ts --target=chromium --env=dev --watch",
    "dev:firefox": "bun scripts/build.ts --target=firefox --env=dev --watch",
    "dev:safari": "bun scripts/build.ts --target=safari --env=dev --watch",
    "build:chromium": "bun scripts/build.ts --target=chromium --env=prod",
    "build:firefox": "bun scripts/build.ts --target=firefox --env=prod",
    "build:safari": "bun scripts/build.ts --target=safari --env=prod",
    "build:all": "bun run build:chromium && bun run build:firefox && bun run build:safari",
    "zip:chromium": "bun run build:chromium && bun scripts/zip.ts --browser=chromium",
    "zip:firefox": "bun run build:firefox && bun scripts/zip.ts --browser=firefox",
    "zip:safari": "bun run build:safari && bun scripts/zip.ts --browser=safari",
    "zip:all": "bun run zip:chromium && bun run zip:firefox && bun run zip:safari",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@tailwindcss/cli": "^4.2.2",
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/webextension-polyfill": "^0.12.5",
    "archiver": "^7.0.1",
    "shadcn": "^4.13.0",
    "typescript": "^5.8.3"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
